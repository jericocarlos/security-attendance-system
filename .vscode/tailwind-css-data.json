{
  "version": 1.1,
  "atDirectives": [
    {
      "name": "@custom-variant",
      "description": "Define a Tailwind custom variant",
      "syntax": "@custom-variant <name> (<selector>)"
    },
    {
      "name": "@theme",
      "description": "Define Tailwind theme variables",
      "syntax": "@theme <name> { ... }"
    },
    {
      "name": "@utility",
      "description": "Define a Tailwind utility",
      "syntax": "@utility <name> { ... }"
    },
    {
      "name": "@variant",
      "description": "Define a Tailwind variant",
      "syntax": "@variant <name> { ... }"
    },
    {
      "name": "@apply",
      "description": "Apply Tailwind utility classes",
      "syntax": "@apply <utility> [<utility> ...]"
    },
    {
      "name": "@source",
      "description": "Configure Tailwind source files",
      "syntax": "@source <path>"
    },
    {
      "name": "@plugin",
      "description": "Load a Tailwind plugin",
      "syntax": "@plugin <name>"
    },
    {
      "name": "@reference",
      "description": "Reference another CSS file for Tailwind",
      "syntax": "@reference <path>"
    },
    {
      "name": "@config",
      "description": "Point Tailwind to a config file",
      "syntax": "@config <path>"
    }
  ]
}
